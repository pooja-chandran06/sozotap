rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all unauthenticated or unhandled collection access
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasOnlyAllowedKeys(allowedKeys) {
      return request.resource.data.keys().hasOnly(allowedKeys);
    }

    // -------------------------------------------------------------------------
    // USERS & SUB-COLLECTIONS
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Emergency Contacts Sub-collection
      match /emergency_contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }

      // Device Tokens (FCM Tokens)
      match /device_tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // Notification Preferences
      match /notification_preferences/{prefId} {
        allow read, write: if isOwner(userId);
      }

      // Privacy & Emergency Sharing Settings
      match /privacy_settings/{prefId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Legacy fallback for top-level emergency_contacts if queried directly
    match /emergency_contacts/{contactId} {
      allow read, write: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // MEDICAL PROFILES
    // -------------------------------------------------------------------------
    match /medical_profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // -------------------------------------------------------------------------
    // EMERGENCY ALERTS
    // -------------------------------------------------------------------------
    match /emergency_alerts/{alertId} {
      allow create: if signedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.status == "active"
      );
      // Owner can update, but cannot overwrite backend audit fields
      allow update: if signedIn() && resource.data.ownerUserId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['alert_sent', 'dispatch_count']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // INBOX NOTIFICATIONS
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.recipientUserId == request.auth.uid;
      // Allow marking as read by recipient
      allow update: if signedIn() 
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false; // Only Cloud Functions can create/delete notifications
    }

    // -------------------------------------------------------------------------
    // MESSAGE DELIVERIES (Backend Audit Logs)
    // -------------------------------------------------------------------------
    match /message_deliveries/{deliveryId} {
      allow read: if signedIn() && (
        resource.data.recipientUserId == request.auth.uid ||
        resource.data.senderUserId == request.auth.uid
      );
      allow write: if false; // Strictly managed by Cloud Functions Admin SDK
    }

    // -------------------------------------------------------------------------
    // EMERGENCY QR TOKENS & AUDITS
    // -------------------------------------------------------------------------
    match /emergency_qr_tokens/{tokenId} {
      allow read: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      // Creation and updates strictly managed via Cloud Functions to enforce token hashing
      allow write: if false;
    }

    match /qr_scan_audits/{auditId} {
      allow read: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // IOT HARDWARE DEVICES & EVENTS (PHASE 9)
    // -------------------------------------------------------------------------
    match /iot_devices/{deviceId} {
      allow read: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow delete: if false;
    }

    match /device_events/{eventId} {
      allow read: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if false;
    }

    match /device_pairing_sessions/{sessionId} {
      allow read: if signedIn() && resource.data.ownerUserId == request.auth.uid;
      allow write: if false; // Strictly managed by Cloud Functions
    }

    // -------------------------------------------------------------------------
    // CAREGIVER RELATIONSHIPS (PHASE 9.4)
    // -------------------------------------------------------------------------
    match /caregiver_relationships/{relId} {
      allow read: if signedIn() && (
        resource.data.ownerUserId == request.auth.uid ||
        resource.data.caregiverUserId == request.auth.uid
      );
      allow write: if false; // Strictly managed by Cloud Functions
    }
  }
}
