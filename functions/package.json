{
  "name": "sozotap-functions",
  "version": "1.0.0",
  "description": "SOZOTAP Secure Backend SOS Dispatch, FCM Notifications & SMS Fallback Engine",
  "scripts": {
    "lint": "npx tsc --noEmit",
    "build": "npx tsc",
    "build:watch": "npx tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:logs",
    "test": "npx jest --passWithNoTests"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^18.19.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "private": true
}
